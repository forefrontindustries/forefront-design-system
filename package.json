{
  "name": "sandbox-app-template",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && bunx vite",
    "dev:desktop": "cd packages/desktop && bunx vite",
    "dev:mobile": "cd packages/mobile && bunx expo start --port $(bun --print \"require('../../__ports.cjs').mobile\")",
    "build": "bun run storybook:embed && turbo build",
    "build:app": "turbo build",
    "build:web": "cd packages/web && bunx vite build",
    "start": "pm2 startOrRestart ecosystem.config.cjs --update-env",
    "stop": "pm2 delete web-app 2>/dev/null || true",
    "kill:port": "bun run internal:kill-port",
    "lint": "runkit lint",
    "lint:fix": "runkit lint --fix",
    "typecheck": "turbo typecheck",
    "tokens:build": "cd packages/tokens && bun scripts/build.ts",
    "tokens:validate": "cd packages/tokens && bun scripts/validate.ts",
    "tokens:contrast": "cd packages/tokens && bun scripts/contrast.ts",
    "lint:tokens": "bun packages/tokens/scripts/lint-tokens.ts",
    "storybook": "cd packages/ui && bun run storybook",
    "build:storybook": "cd packages/ui && bun run build-storybook",
    "changeset": "changeset",
    "storybook:embed": "bun run build:storybook && rm -rf packages/web/public/storybook && cp -r packages/ui/storybook-static packages/web/public/storybook",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "internal:kill-port": "lsof -t -i :$(bun --print \"require('./__ports.cjs').website\") | xargs kill -9"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@runablehq/runkit": "0.1.1",
    "@tursodatabase/api": "^1.9.2",
    "@types/bun": "1.3.14",
    "oxfmt": "0.54.0",
    "turbo": "2.9.18",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@libsql/client": "^0.17.2",
    "cloudflare": "^5.2.0",
    "pm2": "^7.0.1"
  }
}
