{
  "name": "@forefront/tokens",
  "version": "1.0.0",
  "private": false,
  "description": "Forefront Design System tokens: one source of truth, compiled to CSS, TypeScript, Tailwind, React Native, Figma Variables and Material 3 roles.",
  "type": "module",
  "files": ["build", "src", "README.md"],
  "exports": {
    ".": "./build/tokens.ts",
    "./css": "./build/tokens.css",
    "./tailwind": "./build/tokens.tailwind.css",
    "./native": "./build/tokens.native.ts",
    "./figma": "./build/tokens.figma.json",
    "./manifest": "./build/manifest.json",
    "./md3": "./build/tokens.md3.css"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "validate": "bun scripts/validate.ts",
    "contrast": "bun scripts/contrast.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
