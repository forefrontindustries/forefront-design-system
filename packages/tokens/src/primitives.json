{
  "$description": "Tier 1: primitives. Raw, context-free values. These are the only place a literal hex, px, or cubic-bezier is allowed to exist in the entire system. Nothing in a component may reference this tier directly.",
  "color": {
    "$type": "color",
    "ink": {
      "$description": "Blue-tinted near-black ramp for dark surfaces. Every step below is a value in production use on forefrontindustries.io: 1000 is the site canvas, 950 and 900 are the section backgrounds, 850 is the card surface, 750 is the raised panel.",
      "1000": { "$value": "#000000" },
      "950": { "$value": "#07090f" },
      "900": { "$value": "#0a0a12" },
      "850": { "$value": "#0a0c14" },
      "800": { "$value": "#0d1019" },
      "750": { "$value": "#0f0f1a" },
      "700": { "$value": "#202a38" },
      "650": { "$value": "#2a2a35" }
    },
    "slate": {
      "$description": "Cool neutral ramp for light theme surfaces and dark theme text. 300 and 200 are the production muted-text values.",
      "600": { "$value": "#3d4453" },
      "500": { "$value": "#5b6678" },
      "450": { "$value": "#7d8696" },
      "400": { "$value": "#8b93a1" },
      "300": { "$value": "#a4aab4" },
      "200": { "$value": "#c8ccd4" },
      "100": { "$value": "#e2e7ee" },
      "50": { "$value": "#f1f4f8" },
      "25": { "$value": "#f8fafc" },
      "0": { "$value": "#ffffff" }
    },
    "blue": {
      "$description": "Forefront brand accent. 500 is the brand value #5793CA, taken from --primary in the production site stylesheet. 400 is the production hover value #7BA8D1.",
      "950": { "$value": "#091825" },
      "800": { "$value": "#16385a" },
      "700": { "$value": "#1e4c7a" },
      "600": { "$value": "#2f6da4" },
      "500": { "$value": "#5793ca" },
      "400": { "$value": "#7ba8d1" },
      "300": { "$value": "#a3c5e4" },
      "100": { "$value": "#e6eff8" }
    },
    "orange": {
      "$description": "Forefront secondary accent, production value #FF8A3D. Used on the site for glow treatments and emphasis against the blue. Carries the warning role here.",
      "950": { "$value": "#2a1305" },
      "700": { "$value": "#914712" },
      "600": { "$value": "#c25f18" },
      "500": { "$value": "#ff8a3d" },
      "400": { "$value": "#ff9a55" },
      "100": { "$value": "#ffeadb" }
    },
    "green": {
      "$description": "Success hue.",
      "950": { "$value": "#052618" },
      "700": { "$value": "#146c43" },
      "600": { "$value": "#1a8754" },
      "500": { "$value": "#2eb872" },
      "400": { "$value": "#5fd39a" },
      "100": { "$value": "#e3f7ec" }
    },
    "red": {
      "$description": "Danger and destructive hue.",
      "950": { "$value": "#2e0a0c" },
      "700": { "$value": "#a41d24" },
      "600": { "$value": "#c92a32" },
      "500": { "$value": "#e4494f" },
      "400": { "$value": "#ef7b7f" },
      "300": { "$value": "#f6a5a8" },
      "100": { "$value": "#fdeaeb" }
    },
    "alpha": {
      "$description": "Translucent overlays. Needed for scrims and hairlines that must sit over unknown content.",
      "light-08": { "$value": "rgba(255, 255, 255, 0.08)" },
      "dark-08": { "$value": "rgba(7, 9, 15, 0.08)" },
      "scrim-dark": { "$value": "rgba(4, 5, 10, 0.72)" },
      "scrim-cool": { "$value": "rgba(7, 9, 15, 0.48)" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "clash": { "$value": "'Clash Display', -apple-system, BlinkMacSystemFont, sans-serif" },
      "satoshi": { "$value": "'Satoshi', -apple-system, BlinkMacSystemFont, sans-serif" },
      "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "size": {
      "$type": "dimension",
      "$description": "Modular type ramp. Components only consume 40, 50 and 60. Everything above is display scale, set in Clash Display.",
      "10": { "$value": "0.6875rem" },
      "20": { "$value": "0.75rem" },
      "30": { "$value": "0.8125rem" },
      "40": { "$value": "0.875rem" },
      "50": { "$value": "1rem" },
      "60": { "$value": "1.125rem" },
      "70": { "$value": "1.3125rem" },
      "80": { "$value": "1.5rem" },
      "90": { "$value": "1.75rem" },
      "100": { "$value": "2.125rem" },
      "110": { "$value": "2.625rem" },
      "120": { "$value": "3.25rem" },
      "130": { "$value": "4rem" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": "400" },
      "medium": { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold": { "$value": "700" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": "1.1" },
      "snug": { "$value": "1.25" },
      "normal": { "$value": "1.5" },
      "relaxed": { "$value": "1.65" }
    },
    "tracking": {
      "$type": "dimension",
      "tighter": { "$value": "-0.03em" },
      "tight": { "$value": "-0.015em" },
      "normal": { "$value": "0em" },
      "wide": { "$value": "0.04em" },
      "wider": { "$value": "0.12em" }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base grid. Odd steps exist for optical control inset only.",
    "0": { "$value": "0rem" },
    "1": { "$value": "0.125rem" },
    "2": { "$value": "0.25rem" },
    "3": { "$value": "0.375rem" },
    "4": { "$value": "0.5rem" },
    "5": { "$value": "0.75rem" },
    "6": { "$value": "1rem" },
    "7": { "$value": "1.25rem" },
    "8": { "$value": "1.5rem" },
    "9": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "11": { "$value": "3rem" },
    "12": { "$value": "4rem" },
    "13": { "$value": "5rem" },
    "14": { "$value": "6rem" },
    "15": { "$value": "8rem" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0rem" },
    "xs": { "$value": "0.125rem" },
    "sm": { "$value": "0.25rem" },
    "md": { "$value": "0.375rem" },
    "lg": { "$value": "0.625rem" },
    "xl": { "$value": "0.875rem" },
    "2xl": { "$value": "1.25rem" },
    "full": { "$value": "62.4375rem" }
  },
  "border-width": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "thin": { "$value": "1px" },
    "medium": { "$value": "2px" },
    "thick": { "$value": "3px" }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Two families. The dark set uses deeper, tighter shadows because low-luminance surfaces need contrast, not blur.",
    "dark-sm": { "$value": "0 1px 2px rgba(0, 0, 0, 0.4)" },
    "dark-md": { "$value": "0 4px 12px rgba(0, 0, 0, 0.45), 0 1px 2px rgba(0, 0, 0, 0.5)" },
    "dark-lg": { "$value": "0 16px 40px rgba(0, 0, 0, 0.55), 0 2px 6px rgba(0, 0, 0, 0.5)" },
    "light-sm": { "$value": "0 1px 2px rgba(7, 9, 15, 0.08)" },
    "light-md": { "$value": "0 4px 12px rgba(7, 9, 15, 0.1), 0 1px 2px rgba(7, 9, 15, 0.06)" },
    "light-lg": { "$value": "0 16px 40px rgba(7, 9, 15, 0.14), 0 2px 6px rgba(7, 9, 15, 0.08)" },
    "none": { "$value": "none" }
  },
  "duration": {
    "$type": "duration",
    "instant": { "$value": "0ms" },
    "fast": { "$value": "120ms" },
    "moderate": { "$value": "200ms" },
    "slow": { "$value": "320ms" },
    "slower": { "$value": "480ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "standard for state changes, entrance/exit as an asymmetric pair, emphasized for large moves, spring only for playful affordances.",
    "linear": { "$value": "linear" },
    "standard": { "$value": "cubic-bezier(0.2, 0, 0.13, 1)" },
    "emphasized": { "$value": "cubic-bezier(0.3, 0, 0, 1)" },
    "entrance": { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
    "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)" },
    "spring": { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)" }
  },
  "z-index": {
    "$type": "number",
    "base": { "$value": "0" },
    "raised": { "$value": "10" },
    "sticky": { "$value": "100" },
    "overlay": { "$value": "1000" },
    "modal": { "$value": "1100" },
    "popover": { "$value": "1200" },
    "toast": { "$value": "1300" },
    "tooltip": { "$value": "1400" }
  }
}
