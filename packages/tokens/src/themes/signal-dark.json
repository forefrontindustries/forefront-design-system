{
  "$name": "signal-dark",
  "$label": "Signal Dark",
  "$appearance": "dark",
  "$description": "A structurally different theme, not a hue swap. Neutrals move from cool ink to warm sand, the accent becomes amber, radii step up by roughly 2.5x, and the display face changes to Instrument Serif. Every component absorbs this without a single component-level override, which is the argument for the three-tier token architecture.",
  "color": {
    "surface": {
      "canvas": { "$value": "{color.sand.950}" },
      "sunken": { "$value": "{color.sand.1000}" },
      "raised": { "$value": "{color.sand.900}" },
      "overlay": { "$value": "{color.sand.800}" },
      "scrim": { "$value": "{color.alpha.scrim-light}" },
      "control": { "$value": "{color.sand.900}" },
      "control-hover": { "$value": "{color.sand.800}" },
      "disabled": { "$value": "{color.sand.800}" },
      "selected": { "$value": "{color.amber.950}" },
      "accent-subtle": { "$value": "{color.amber.950}" },
      "accent-bold": { "$value": "{color.amber.500}" },
      "accent-bold-hover": { "$value": "{color.amber.400}" },
      "accent-bold-active": { "$value": "{color.amber.300}" },
      "neutral-subtle": { "$value": "{color.sand.800}" },
      "neutral-subtle-hover": { "$value": "{color.sand.700}" },
      "neutral-bold": { "$value": "{color.sand.100}" },
      "success-subtle": { "$value": "{color.green.950}" },
      "success-bold": { "$value": "{color.green.500}" },
      "warning-subtle": { "$value": "{color.amber.900}" },
      "warning-bold": { "$value": "{color.amber.500}" },
      "danger-subtle": { "$value": "{color.red.950}" },
      "danger-bold": { "$value": "{color.red.400}" },
      "danger-bold-hover": { "$value": "{color.red.300}" },
      "info-subtle": { "$value": "{color.blue.950}" },
      "info-bold": { "$value": "{color.blue.500}" }
    },
    "text": {
      "primary": { "$value": "{color.sand.25}" },
      "secondary": { "$value": "{color.sand.300}" },
      "subtle": { "$value": "{color.sand.400}" },
      "placeholder": { "$value": "{color.sand.400}" },
      "disabled": { "$value": "{color.sand.450}" },
      "accent": { "$value": "{color.amber.400}" },
      "on-accent": { "$value": "{color.sand.1000}" },
      "on-neutral-bold": { "$value": "{color.sand.950}" },
      "on-danger": { "$value": "{color.red.950}" },
      "success": { "$value": "{color.green.400}" },
      "warning": { "$value": "{color.amber.300}" },
      "danger": { "$value": "{color.red.400}" },
      "info": { "$value": "{color.blue.400}" },
      "link": { "$value": "{color.amber.300}" },
      "link-hover": { "$value": "{color.amber.200}" }
    },
    "border": {
      "subtle": { "$value": "{color.alpha.light-08}" },
      "default": { "$value": "{color.sand.700}" },
      "strong": { "$value": "{color.sand.600}" },
      "control": { "$value": "{color.sand.450}" },
      "control-hover": { "$value": "{color.sand.400}" },
      "accent": { "$value": "{color.amber.500}" },
      "focus": { "$value": "{color.amber.400}" },
      "success": { "$value": "{color.green.500}" },
      "warning": { "$value": "{color.amber.500}" },
      "danger": { "$value": "{color.red.500}" },
      "disabled": { "$value": "{color.sand.600}" }
    },
    "icon": {
      "primary": { "$value": "{color.sand.300}" },
      "subtle": { "$value": "{color.sand.400}" },
      "accent": { "$value": "{color.amber.400}" },
      "on-accent": { "$value": "{color.sand.1000}" }
    }
  },
  "elevation": {
    "raised": { "$value": "{shadow.dark-sm}" },
    "overlay": { "$value": "{shadow.dark-md}" },
    "modal": { "$value": "{shadow.dark-lg}" },
    "none": { "$value": "{shadow.none}" }
  },
  "radius": {
    "control": { "$value": "{radius.lg}" },
    "surface": { "$value": "{radius.xl}" },
    "overlay": { "$value": "{radius.2xl}" },
    "pill": { "$value": "{radius.full}" }
  },
  "font": {
    "display": { "$value": "{font.family.instrument}" },
    "body": { "$value": "{font.family.public-sans}" },
    "mono": { "$value": "{font.family.jetbrains}" }
  }
}
