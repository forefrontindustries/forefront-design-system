{
  "$name": "signal-light",
  "$label": "Signal Light",
  "$appearance": "light",
  "$description": "Warm paper light theme. Accent drops to amber.700 because amber.500 cannot carry white text at 4.5:1, a concrete example of why accent-bold is theme-owned rather than a fixed brand hex.",
  "color": {
    "surface": {
      "canvas": { "$value": "{color.sand.50}" },
      "sunken": { "$value": "{color.sand.100}" },
      "raised": { "$value": "{color.sand.25}" },
      "overlay": { "$value": "{color.sand.25}" },
      "scrim": { "$value": "{color.alpha.scrim-light}" },
      "control": { "$value": "{color.sand.25}" },
      "control-hover": { "$value": "{color.sand.50}" },
      "disabled": { "$value": "{color.sand.100}" },
      "selected": { "$value": "{color.amber.100}" },
      "accent-subtle": { "$value": "{color.amber.100}" },
      "accent-bold": { "$value": "{color.amber.700}" },
      "accent-bold-hover": { "$value": "{color.amber.800}" },
      "accent-bold-active": { "$value": "{color.amber.900}" },
      "neutral-subtle": { "$value": "{color.sand.100}" },
      "neutral-subtle-hover": { "$value": "{color.sand.200}" },
      "neutral-bold": { "$value": "{color.sand.900}" },
      "success-subtle": { "$value": "{color.green.100}" },
      "success-bold": { "$value": "{color.green.600}" },
      "warning-subtle": { "$value": "{color.amber.100}" },
      "warning-bold": { "$value": "{color.amber.600}" },
      "danger-subtle": { "$value": "{color.red.100}" },
      "danger-bold": { "$value": "{color.red.600}" },
      "danger-bold-hover": { "$value": "{color.red.700}" },
      "info-subtle": { "$value": "{color.blue.100}" },
      "info-bold": { "$value": "{color.blue.600}" }
    },
    "text": {
      "primary": { "$value": "{color.sand.1000}" },
      "secondary": { "$value": "{color.sand.600}" },
      "subtle": { "$value": "{color.sand.500}" },
      "placeholder": { "$value": "{color.sand.500}" },
      "disabled": { "$value": "{color.sand.450}" },
      "accent": { "$value": "{color.amber.800}" },
      "on-accent": { "$value": "{color.sand.25}" },
      "on-neutral-bold": { "$value": "{color.sand.25}" },
      "on-danger": { "$value": "{color.slate.0}" },
      "success": { "$value": "{color.green.700}" },
      "warning": { "$value": "{color.amber.800}" },
      "danger": { "$value": "{color.red.700}" },
      "info": { "$value": "{color.blue.700}" },
      "link": { "$value": "{color.amber.800}" },
      "link-hover": { "$value": "{color.amber.900}" }
    },
    "border": {
      "subtle": { "$value": "{color.alpha.dark-08}" },
      "default": { "$value": "{color.sand.200}" },
      "strong": { "$value": "{color.sand.300}" },
      "control": { "$value": "{color.sand.400}" },
      "control-hover": { "$value": "{color.sand.450}" },
      "accent": { "$value": "{color.amber.700}" },
      "focus": { "$value": "{color.amber.700}" },
      "success": { "$value": "{color.green.600}" },
      "warning": { "$value": "{color.amber.600}" },
      "danger": { "$value": "{color.red.600}" },
      "disabled": { "$value": "{color.sand.200}" }
    },
    "icon": {
      "primary": { "$value": "{color.sand.600}" },
      "subtle": { "$value": "{color.sand.500}" },
      "accent": { "$value": "{color.amber.800}" },
      "on-accent": { "$value": "{color.sand.25}" }
    }
  },
  "elevation": {
    "raised": { "$value": "{shadow.light-sm}" },
    "overlay": { "$value": "{shadow.light-md}" },
    "modal": { "$value": "{shadow.light-lg}" },
    "none": { "$value": "{shadow.none}" }
  },
  "radius": {
    "control": { "$value": "{radius.lg}" },
    "surface": { "$value": "{radius.xl}" },
    "overlay": { "$value": "{radius.2xl}" },
    "pill": { "$value": "{radius.full}" }
  },
  "font": {
    "display": { "$value": "{font.family.instrument}" },
    "body": { "$value": "{font.family.public-sans}" },
    "mono": { "$value": "{font.family.jetbrains}" }
  }
}
