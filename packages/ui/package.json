    "@storybook/react-vite": "^9.1.10",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.1.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "storybook": "^9.1.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
